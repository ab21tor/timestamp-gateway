# ── Payment backend ──────────────────────────────────────────────────
# phoenixd is the LIVE backend and the default. lnd is a test payer /
# alternative backend only (see ops/OPERATOR-NOTES.md).
PAYMENT_BACKEND_TYPE=phoenixd
# phoenixd HTTP API endpoint (live default backend). phoenixd runs OUTSIDE
# the compose stack (it is the wallet holding your funds); from the gateway
# container, host.docker.internal is the Docker host it runs on.
# REACHABILITY: phoenixd binds 127.0.0.1 by default. host.docker.internal
# reaches a loopback-bound phoenixd only on Docker Desktop (macOS/Windows,
# via its VM proxy). On a Linux engine (VPS, Pi, Umbrel, Start9) it maps to
# a bridge IP where a loopback-bound phoenixd is not listening: connection
# refused. A container-run gateway needs phoenixd bound where the container
# can reach it — --http-bind-ip on the docker0 bridge address, or a reverse
# proxy in front of it.
PHOENIXD_URL=http://host.docker.internal:9740
# systemd path (gateway runs on the host itself; phoenixd's loopback
# default works as-is):
# PHOENIXD_URL=http://127.0.0.1:9740
# phoenixd HTTP API password: use http-password-limited-access from
# phoenix.conf. It covers everything the gateway calls (createinvoice,
# getinfo, payments/incoming) and cannot spend. NEVER the full
# http-password — that one authorizes /payinvoice and /sendtoaddress.
# The pre-rename name PHOENIXD_HTTP_PASSWORD is still read as a fallback.
# Real value in .env only — never commit it.
PHOENIXD_HTTP_PASSWORD_LIMITED=replace-with-phoenixd-http-password-limited-access

# ── LND (test payer / alternative backend only) ──────────────────────
# All LND_* vars below are read only when PAYMENT_BACKEND_TYPE=lnd (test payer).
# LND is NOT the live backend; it is the test payer in operator scripts.
# LND REST endpoint (test payer / alternative): hostname, IP, or .onion address.
LND_HOST=
# REST API port (LND default is 8080; test payer / alternative).
LND_PORT=8080
# Hex-encoded INVOICE macaroon: invoice scope only.
# NEVER use admin.macaroon. The gateway only creates and reads invoices.
# Example:
#   lncli bakemacaroon invoices:read invoices:write address:read offchain:read --save_to invoice.macaroon
#   xxd -p -c 256 invoice.macaroon
LND_MACAROON_HEX=
# Hex-encoded readonly macaroon, optional but recommended.
# Used only by /health to call LND /v1/getinfo with least privilege (test payer).
# Falls back to LND_MACAROON_HEX if unset (test payer / alternative).
LND_READONLY_MACAROON_HEX=
# LND REST TLS certificate verification (lnd backend only).
# Usually false for self-hosted LND with a self-signed certificate (test payer).
# Use proper HTTPS/TLS in production because L402 credentials travel in headers.
LND_TLS_VERIFY=false
# Tor SOCKS proxy for LND connections (lnd backend only).
# Required if LND_HOST is .onion. Leave blank for direct clearnet LND (test payer).
# Use tor:9050 with the bundled Docker Compose Tor service.
TOR_PROXY=tor:9050

# Gateway URL for operator scripts (status, audit, paid proof test).
# Host where callers reach the gateway — e.g. a Tailscale IP or onion address.
# Real value in .env only.
GATEWAY_URL=http://<gateway-host>:8000

# Price charged per timestamp request, in sats. Must be a positive integer.
GATEWAY_PRICE_SATS=500
# ── Pricing solvency floor ───────────────────────────────────────────
# The 402 challenge quotes max(GATEWAY_PRICE_SATS, floor), where
#   floor = ceil(PRICE_TX_VSIZE_ESTIMATE x feerate x PRICE_BUMP_RESERVE
#                x PRICE_MARGIN)
# and the feerate comes from estimatesmartfee(PRICE_CONF_TARGET) over
# Bitcoin RPC, cached for 60 seconds. The gateway is structurally unable
# to quote below anchoring cost; when no feerate is available the floor
# is PRICE_BLIND_SATS (below) and a warning logs — pricing stays safe,
# payments never stop.
# Bitcoin RPC URL for fee estimation ONLY. Recommended: a node-level
# credential with no wallet in the URL path, e.g. a whitelisted
# estimatesmartfee-only user at http://user:password@127.0.0.1:18332/
# Real value in .env only — never commit it, never on command lines.
# Empty: falls back to BITCOIN_RPC_SERVICE_URL below. Honest caveat: that
# fallback hands the gateway process a WALLET-scoped credential (it names
# /wallet/otsd-hot), which the rails-separation rule otherwise forbids —
# convenient for a single-credential box, but set a dedicated node-level
# PRICE_RPC_URL if you can. With both empty the gateway is permanently
# blind and quotes max(GATEWAY_PRICE_SATS, PRICE_BLIND_SATS).
PRICE_RPC_URL=
# Assumed anchoring transaction size in vbytes (conservative
# single-input P2WPKH + change + OP_RETURN).
PRICE_TX_VSIZE_ESTIMATE=150
# Headroom multiplier for fee-bumping a stuck anchor (RBF/CPFP). >= 1.
PRICE_BUMP_RESERVE=1.5
# Margin multiple over estimated anchoring cost. >= 1; below 1 would
# quote at a loss and is refused at startup.
PRICE_MARGIN=5
# Confirmation target (blocks) the QUOTE assumes for estimatesmartfee,
# 1-1008. otsd's own --btc-conf-target is its own config; this one only
# prices the quote.
PRICE_CONF_TARGET=6
# Quote floor when the gateway is BLIND — no feerate available (no RPC
# URL, node down or timing out, no estimate). Blind, the gateway cannot
# tell a calm market from a spiking one, so it quotes a price the market
# cannot hurt it with: 5000 sats covers a 20 sat/vB anchor at cost with
# margin. Positive integer; the 402 quotes max(GATEWAY_PRICE_SATS, this).
PRICE_BLIND_SATS=5000
# ── Invoice-mint rate limit ──────────────────────────────────────────
# Per-IP cap on unauthenticated 402 challenges per minute (token bucket;
# the same value is the burst allowance). Every anonymous request makes
# phoenixd sign and store an invoice, so this bounds what a spammer can
# make your node do for free. 0 disables the limit. Over-limit requests
# get 429 with a Retry-After header.
RATE_LIMIT_PER_MINUTE=10
# Per-IP cap on the free proof endpoints (/verify and /upgrade), per
# minute — one bucket shared by both. Separate knob from the mint limit:
# these cost gateway CPU and private-calendar round-trips, not phoenixd
# storage, and clients legitimately poll /upgrade while an anchor pends,
# so free traffic must never starve the paid mint path. 0 disables.
VERIFY_RATE_LIMIT_PER_MINUTE=30
# Set true ONLY if a reverse proxy you control sits in front of the
# gateway; the rate limiter then reads the client address from the
# rightmost X-Forwarded-For entry (the one your proxy appended). False:
# the header is ignored — it is client-forgeable.
GATEWAY_BEHIND_PROXY=false
# OTS backend mode.
# calendar = operator-controlled OTS calendar, intended production mode.
# public = public OpenTimestamps aggregators, compatibility/testing only.
OTS_BACKEND_MODE=calendar
# Operator-controlled OpenTimestamps calendar server.
# Required when OTS_BACKEND_MODE=calendar.
# Compose (bundled otsd, --profile calendar): service DNS on the compose
# network. Leave blank when OTS_BACKEND_MODE=public.
OTS_CALENDAR_URL=http://otsd:14788
# systemd path (otsd container on host networking, loopback only):
# OTS_CALENDAR_URL=http://127.0.0.1:14788
# L402 macaroon root signing key. REQUIRED for production.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it secret. Never commit it.
L402_SECRET_HEX=
# DEV ONLY, unsafe for production.
# If true and L402_SECRET_HEX is unset, a random per-process key is generated.
# That invalidates paid-but-unredeemed tokens on every restart.
L402_ALLOW_EPHEMERAL_SECRET=false
# Validity window, in seconds, for an issued L402 token.
# A client may retry the paid request with the same token and preimage within this window.
L402_TOKEN_EXPIRY_SECONDS=3600
# Calendar-mode OTS submission retry count. Must be >= 1.
OTS_SUBMIT_MAX_ATTEMPTS=5
# Delay between OTS submission attempts, in seconds. Must be >= 0.
OTS_SUBMIT_BACKOFF_SECONDS=2
# Durable obligation log (SQLite).
# Records each settled payment as an obligation to stamp, so a paid request is
# never lost if calendar submission fails: the row stays 'needs_stamp' and the
# background sweeper retries it until stamped. This is a durable backstop to the
# in-memory proof cache, NOT a replacement — the DB is never used to validate a
# proof. Under Docker this path lives on the persistent gateway_data volume; the
# process fails to start if the path is unwritable.
OBLIGATIONS_DB_PATH=/var/lib/timestamp-gateway/obligations.db
# How often the sweeper retries obligations left in 'needs_stamp', in seconds.
# Must be a positive integer.
OBLIGATION_SWEEP_INTERVAL=1800
# ── Wallet liquidity alarm ───────────────────────────────────────────
# ops/wallet-balance-check.sh (run by wallet-balance-check.timer, every 30
# min) reads the otsd-hot wallet balance over Bitcoin RPC and writes a status
# file. /health reads ONLY the file — the gateway never talks to Bitcoin RPC
# and never holds wallet credentials.
# Alarm threshold in sats (read by ops/wallet-balance-check.sh).
WALLET_MIN_SATS=50000
# Status file path (written by the script, read by /health).
WALLET_STATUS_PATH=/var/lib/timestamp-gateway/wallet-status
# /health reports "stale" (503) when the file is older than this many seconds
# (default 2x the 30-min timer interval) — catches the timer itself dying.
WALLET_STATUS_MAX_AGE_SECONDS=3600
# ── Proof sweep status ───────────────────────────────────────────────
# ops/upgrade-all-proofs.sh (run by timestamp-gateway-upgrade-proofs.timer,
# every 30 min) upgrades pending proofs against the local calendar and writes
# a status file. /health reads ONLY the file.
# Status file path (written by the sweep, read by /health).
PROOFS_STATUS_PATH=/var/lib/timestamp-gateway/proofs-status
# /health reports "stale" (503) when the file is older than this many seconds
# (default 2x the 30-min sweep interval) — catches the sweep timer dying.
PROOFS_STATUS_MAX_AGE_SECONDS=3600
# ── Alarm delivery ───────────────────────────────────────────────────
# ops/notify.sh reads a message on stdin and POSTs it to this ntfy topic URL.
# Full URL including topic; pick a long random topic name nobody can guess.
# Treat it as a secret: anyone holding the URL can read alarms and post to
# the topic. Real value in .env only — never commit it. When unset,
# notify.sh logs and exits non-zero: an unconfigured alarm channel is a
# failure, not silence.
NTFY_URL=https://ntfy.sh/replace-with-your-random-topic
# ops/health-monitor.sh (run by health-monitor.timer, every 5 min) polls
# /health and pushes through ops/notify.sh on any non-ok state, once more on
# recovery to ok. A persisting problem re-alerts after this cooldown, in
# seconds; condition changes always push immediately.
HEALTH_REALERT_SECONDS=14400
# URL the monitor polls (the gateway as seen from the box itself).
HEALTH_URL=http://127.0.0.1:8000/health
# Debounce state file: the last condition actually delivered + when.
HEALTH_MONITOR_STATE_PATH=/var/lib/timestamp-gateway/health-monitor-state
# ── otsd Bitcoin RPC (calendar profile only) ─────────────────────────
# Full URL including credentials. Keep ONLY in .env (gitignored) —
# never in tracked files, never on command lines (visible in ps).
# Rotate the password if it ever appears in either.
# Compose, node reachable from this host (LAN or local bitcoind):
BITCOIN_RPC_SERVICE_URL=http://rpcuser:rpcpassword@host.docker.internal:18332/wallet/otsd-hot
# Compose, onion-only node via the bundled bridge (--profile onion-rpc;
# set BITCOIN_RPC_ONION below):
# BITCOIN_RPC_SERVICE_URL=http://rpcuser:rpcpassword@rpc-bridge:18332/wallet/otsd-hot
# systemd path (host socat bridge, deploy/socat-bitcoin-rpc.service.example):
# BITCOIN_RPC_SERVICE_URL=http://rpcuser:rpcpassword@127.0.0.1:18332/wallet/otsd-hot
# Your Bitcoin node's RPC onion address (no port), used only by the
# rpc-bridge service (--profile onion-rpc). Keep the real address out of git.
BITCOIN_RPC_ONION=
# Path to the opentimestamps-server fork checkout (mounted into otsd at /app):
# https://github.com/ab21tor/opentimestamps-server, branch calendar-ops.
# Compose default: a checkout next to this repo.
OTSD_FORK_PATH=../opentimestamps-server
# systemd path (VPS layout):
# OTSD_FORK_PATH=/home/gateway/opentimestamps-server
# ── Compose storage overrides (optional; named volumes when unset) ───
# Host directory for /var/lib/timestamp-gateway (obligation log, PAUSED
# switch, ops status files). Set to /var/lib/timestamp-gateway when this
# host also runs the ops/ systemd timers, so the status files they write
# are the ones the containerized /health reads.
# GATEWAY_STATE_DIR=/var/lib/timestamp-gateway
# Host directory for otsd calendar state (the proof namespace).
# OTSD_CALENDAR_DIR=/var/lib/otsd/calendar
# ── Backups (ops/backup-live-state.sh; see ops/BACKUP-RECOVERY.md) ───
# Where archives are written on this box.
BACKUP_ROOT=/home/gateway/timestamp-gateway-live-backups
# age PUBLIC key (age1...) that archives are encrypted to. The private key
# must live off this box — losing it makes every pushed backup unreadable.
# Empty: archives stay plaintext on this box and are never pushed.
BACKUP_AGE_RECIPIENT=
# Off-box rsync destination for encrypted archives, form user@host:path.
# Empty: backups stay on this box and share fate with it.
BACKUP_REMOTE=
# Newest archives kept in BACKUP_ROOT; older ones are pruned.
BACKUP_KEEP=7
# Status file the gateway's /health reads (written by the backup run).
BACKUP_STATUS_PATH=/var/lib/timestamp-gateway/backup-status
# Age beyond which /health treats the backup status as stale (the timer
# died), in seconds. Default is 2x the daily timer.
BACKUP_STATUS_MAX_AGE_SECONDS=172800
