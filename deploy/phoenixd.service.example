# phoenixd under systemd: the Lightning wallet holding the gateway's funds.
# phoenixd stays OUTSIDE the compose stack by design; this unit runs it on
# the Docker host, bound where the gateway container can reach it.
# Copy to /etc/systemd/system/phoenixd.service, then:
# systemctl daemon-reload && systemctl enable --now phoenixd
#
# ITS OWN USER (2026-09-15 review F06): the wallet's seed and its full
# spending password live in the phoenixd user's home, mode 700, which the
# gateway user cannot read. Until 2026-09-18 both units ran as the gateway
# user, so code execution in the web process reached the wallet's files by
# ownership whatever password the gateway was given. Create the user and
# the home once, unpack the release under /opt/phoenixd (root-owned, the
# binary is not writable by the service user), and run phoenixd once by
# hand AS THAT USER before enabling the unit — the first run is interactive
# and creates ~/.phoenix (the wallet seed, and the API passwords in
# phoenix.conf):
#   sudo useradd --system --home-dir /var/lib/phoenixd --create-home \
#     --shell /usr/sbin/nologin phoenixd
#   sudo chmod 700 /var/lib/phoenixd
#   sudo mkdir -p /opt/phoenixd && sudo tar -xzf phoenixd-*-linux-x64.zip -C /opt/phoenixd --strip-components=1
#   sudo -u phoenixd HOME=/var/lib/phoenixd /opt/phoenixd/phoenixd --http-bind-ip 172.17.0.1
# Copy http-password-limited-access out of /var/lib/phoenixd/.phoenix/
# phoenix.conf into the gateway's .env as PHOENIXD_HTTP_PASSWORD_LIMITED
# (that key cannot spend); the full http-password stays in the file, which
# only phoenixd and root can read. seed.dat in that directory IS the money:
# back it up off-box before taking payments (ops/BACKUP-RECOVERY.md).
#
# A box deployed before 2026-09-18 with the wallet under the gateway user's
# home moves it: stop phoenixd, `mv /home/gateway/phoenixd/home/.phoenix
# /var/lib/phoenixd/.phoenix && chown -R phoenixd:phoenixd /var/lib/phoenixd
# && chmod 700 /var/lib/phoenixd`, install this unit, start it. The
# backup's PHOENIX_HOME defaults to the new path.
#
# WHY --http-bind-ip 172.17.0.1 (the docker0 bridge address): phoenixd
# binds 127.0.0.1 by default, and on a Linux engine a container cannot
# reach the host's loopback — host.docker.internal maps to a bridge IP
# (compose sets it via host-gateway), where a loopback-bound phoenixd is
# not listening. Binding the docker0 address pairs with
# PHOENIXD_URL=http://host.docker.internal:9740 in .env: both name the
# same bridge, so the gateway container reaches the API. (Docker Desktop
# on macOS/Windows proxies loopback and does not need this bind; the
# reachability matrix: operator guide, "Payment backend (phoenixd)".)
#
# NEVER --http-bind-ip 0.0.0.0 on a public VPS: the API would answer to
# anyone who finds the port. Even the limited password must not be
# internet-reachable.
#
# After=docker.service: the docker0 bridge must exist before phoenixd can
# bind its address.

[Unit]
Description=phoenixd Lightning payment backend
Wants=network-online.target
After=network-online.target docker.service

[Service]
User=phoenixd
Group=phoenixd
WorkingDirectory=/var/lib/phoenixd
Environment=HOME=/var/lib/phoenixd
ExecStart=/opt/phoenixd/phoenixd --http-bind-ip 172.17.0.1
# The wallet writes only its own home; nothing else on the box is writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/phoenixd
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
