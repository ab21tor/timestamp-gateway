# timestamp-gateway under systemd (bare-metal path).
# Copy to /etc/systemd/system/timestamp-gateway.service, adjust the paths
# and the bind address for your host, then:
# systemctl daemon-reload && systemctl enable --now timestamp-gateway
#
# Paths below assume the repo at /home/gateway/timestamp-gateway with a
# .venv created per the operator guide ("Running without Docker").

[Unit]
Description=timestamp-gateway Lightning-gated OpenTimestamps gateway
# phoenixd (the default payment backend) needs no unit dependency.
# Operators running the lnd test-payer may add lnd.service here.
After=network.target

[Service]
User=gateway
WorkingDirectory=/home/gateway/timestamp-gateway
EnvironmentFile=/home/gateway/timestamp-gateway/.env
# Set --host to where the gateway should actually listen. 127.0.0.1 suits a
# box where a Tor hidden service or reverse proxy on this same host is the
# only front door. The reference deployment instead binds a private
# (tailnet) address, so monitoring and operator tooling on other machines
# reach it without any public exposure — choose that shape when anything
# off-box must hit the gateway directly. A public bind belongs behind the
# operator guide's "Clearnet exposure" guidance. The health monitor's
# HEALTH_URL must match this bind — see the operator guide's Monitoring
# section.
# --no-access-log: no per-request client-IP log — the gateway keeps no
# client-identity records (README, "Privacy trade-offs").
# python -m uvicorn, not the .venv/bin/uvicorn console script: the script's
# shebang hardcodes the venv path at install time and rots when the venv is
# rebuilt or moved; -m resolves through the interpreter that exists now.
ExecStart=/home/gateway/timestamp-gateway/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --no-access-log

# Sandboxing: the gateway writes only its state directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/timestamp-gateway
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
