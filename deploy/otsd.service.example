# otsd calendar under systemd (bare-metal path): runs the otsd container via
# docker run. Copy to /etc/systemd/system/otsd.service, adjust the paths,
# then: systemctl daemon-reload && systemctl enable --now otsd
#
# Companion file /etc/systemd/system/otsd.env holds BITCOIN_RPC_SERVICE_URL
# — the full RPC URL including credentials. It must be owned by the SERVICE
# USER below (User=otsd), mode 600 — NOT root: --env-file is read by the
# docker client, which runs as that user, so a root-owned 600 file fails
# with EACCES. Docker reads the file directly (--env-file below), so the URL
# never appears on a command line (ps/argv) and never in tracked files.
# Residual: `docker inspect otsd` still shows the container's env to local
# root — unavoidable for container env, and why backup archives must stay
# encrypted.
#
# Privilege boundary (operator guide, "Privilege boundary"): this unit runs
# as its own user, `otsd`, the one identity on the box in the docker group
# and the one that can read otsd.env. The gateway's user (`gateway`,
# deploy/timestamp-gateway.service.example) is in neither position, so the
# internet-facing process can reach neither the wallet's RPC credential nor
# the Docker socket. Create the user once:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin otsd
#   sudo usermod -aG docker otsd
#   sudo chown otsd:otsd /etc/systemd/system/otsd.env && sudo chmod 600 /etc/systemd/system/otsd.env
#   sudo chown -R otsd:otsd /var/lib/otsd
# The fork checkout mounted at /app must be readable by otsd (a world-
# readable checkout is; `sudo chgrp -R otsd` it otherwise).
#
# The otsd-local image is built per otsd/Dockerfile with the
# opentimestamps-server fork checkout as the named "fork" build context
# (exact command in the Dockerfile header). The same checkout is mounted at
# /app, so code-only updates deploy with a git pull + systemctl restart otsd
# — no rebuild.
#
# First run only: /var/lib/otsd/calendar needs the three identity files
# (uri, hmac-key, donation_addr) or otsd exits at startup — see the operator
# guide, "Deploying the calendar (otsd)". Fee policy: --btc-conf-target 12
# matches the deployed policy; --btc-max-fee takes BTC (0.0002 BTC = 20,000
# sats — never "fix" 0.0002 to 20000, that would mean 20,000 BTC). Cap
# semantics: operator guide, "Bitcoin transaction cost".

[Unit]
Description=otsd OpenTimestamps calendar (docker)
# Drop socat-bitcoin-rpc.service from both lines if your Bitcoin node is
# reachable without the Tor bridge.
After=docker.service socat-bitcoin-rpc.service
Requires=docker.service socat-bitcoin-rpc.service

[Service]
# The otsd user: docker group member, owner of otsd.env and /var/lib/otsd.
# Never the gateway's user (see the header).
User=otsd
ExecStartPre=-/usr/bin/docker rm -f otsd
ExecStart=/usr/bin/docker run --name otsd --network host \
  -v /var/lib/otsd/calendar:/calendar \
  -v /home/gateway/opentimestamps-server:/app \
  -w /app \
  --env-file /etc/systemd/system/otsd.env \
  otsd-local python3 otsd --calendar /calendar --btc-conf-target 12 --btc-max-fee 0.0002
Restart=on-failure

# Sandboxing for the docker CLI client (the container's own confinement is
# docker's): full, not strict — the client needs its socket and config.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
RestartSec=30

[Install]
WantedBy=multi-user.target
