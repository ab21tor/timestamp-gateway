# otsd calendar under systemd (bare-metal path): runs the otsd container via
# docker run. Copy to /etc/systemd/system/otsd.service, adjust the paths,
# then: systemctl daemon-reload && systemctl enable --now otsd
#
# Companion file /etc/systemd/system/otsd.env (root-owned, mode 600) holds
# BITCOIN_RPC_SERVICE_URL — the full RPC URL including credentials. Docker
# reads that file directly (--env-file below), so the URL never appears on a
# command line (ps/argv) and never in tracked files. Residual: `docker
# inspect otsd` still shows the container's env to local root — unavoidable
# for container env, and why backup archives must stay encrypted.
#
# The otsd-local image is built per otsd/Dockerfile with the
# opentimestamps-server fork checkout as the named "fork" build context
# (exact command in the Dockerfile header). The same checkout is mounted at
# /app, so code-only updates deploy with a git pull + systemctl restart otsd
# — no rebuild.
#
# First run only: /var/lib/otsd/calendar needs the three identity files
# (uri, hmac-key, donation_addr) or otsd exits at startup — see the operator
# guide, "Deploying the calendar (otsd)". --btc-conf-target 12 matches the
# deployed fee policy. --btc-max-fee caps what ONE anchor can cost across
# its whole RBF bump ladder — chosen so a bad fee market cannot drain a
# small wallet in a single transaction. The flag takes BTC:
# 0.0002 BTC = 20,000 sats. Never "fix" 0.0002 to 20000 — that would mean
# 20,000 BTC.

[Unit]
Description=otsd OpenTimestamps calendar (docker)
# Drop socat-bitcoin-rpc.service from both lines if your Bitcoin node is
# reachable without the Tor bridge.
After=docker.service socat-bitcoin-rpc.service
Requires=docker.service socat-bitcoin-rpc.service

[Service]
# The service user needs docker group membership; or run as root and omit this line.
User=gateway
ExecStartPre=-/usr/bin/docker rm -f otsd
ExecStart=/usr/bin/docker run --name otsd --network host \
  -v /var/lib/otsd/calendar:/calendar \
  -v /home/gateway/opentimestamps-server:/app \
  -w /app \
  --env-file /etc/systemd/system/otsd.env \
  otsd-local python3 otsd --calendar /calendar --btc-conf-target 12 --btc-max-fee 0.0002
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
